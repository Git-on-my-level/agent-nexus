--- /dev/null
+++ b/core/internal/scopedrepo/readmodel_hook.go
@@ -0,0 +1,72 @@
+package scopedrepo
+
+import (
+	"context"
+	"database/sql"
+
+	"agent-nexus-core/internal/readmodel"
+	"agent-nexus-core/internal/scopes"
+)
+
+// applyScopeReadModelChange is a proposed lead-owned canonical mutation hook.
+// The lead's Writer must validate its current scope/grant capability, derive
+// before/after from canonical Change fields, and call this in the SAME source
+// transaction. Any error must roll back the source event/answer and all deltas.
+// Do not expose tx, this helper or a repository factory to business handlers.
+// It is not constructor wiring: the frozen Writer/Change API remains required.
+func applyScopeReadModelChange(ctx context.Context, tx *sql.Tx, scope scopes.ID, before, after *readmodel.Projection) error {
+	if tx == nil || scope == "" {
+		return scopes.ErrDenied
+	}
+	for _, p := range []*readmodel.Projection{before, after} {
+		if p != nil && p.ScopeID != scope {
+			return scopes.ErrDerivation
+		}
+	}
+	delta, err := readmodel.PlanDelta(before, after)
+	if err != nil {
+		return err
+	}
+	for _, change := range delta.Feeds {
+		p, e := change.Projection, change.Entry
+		var result sql.Result
+		if change.Delete {
+			result, err = tx.ExecContext(ctx, readmodel.DeleteFeed, p.ScopeID, p.Generation, e.Family, e.Audience, e.Sort, p.RID, p.Version)
+		} else {
+			result, err = tx.ExecContext(ctx, readmodel.InsertFeed, p.ScopeID, p.Generation, e.Family, e.Audience, e.Sort, p.RID, p.Version)
+		}
+		if err != nil {
+			return err
+		}
+		if err = requireReadModelRow(result); err != nil {
+			return err
+		}
+	}
+	for _, change := range delta.Counters {
+		key := change.Key
+		var result sql.Result
+		if change.Delta > 0 {
+			result, err = tx.ExecContext(ctx, readmodel.IncrementCounter, key.ScopeID, key.Generation, key.Family, key.Audience, key.Bucket, change.Delta)
+		} else {
+			result, err = tx.ExecContext(ctx, readmodel.DecrementCounter, change.Delta, key.ScopeID, key.Generation, key.Family, key.Audience, key.Bucket)
+		}
+		if err != nil {
+			return err
+		}
+		if err = requireReadModelRow(result); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func requireReadModelRow(result sql.Result) error {
+	n, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return readmodel.ErrProjection
+	}
+	return nil
+}
