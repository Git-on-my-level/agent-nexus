+package primitives
+
+import (
+	"context"
+
+	"agent-nexus-core/internal/scopedrepo"
+	"agent-nexus-core/internal/scopemigrate"
+	"agent-nexus-core/internal/scopes"
+)
+
+// scopeMigrationHook is a trusted constructor-injected adapter. A owns all
+// call sites and must preserve the existing canonical source transaction.
+type scopeMigrationHook struct{}
+
+func (scopeMigrationHook) ApplyCanonical(ctx context.Context, tx scopedrepo.MutationTx, mutation scopes.CanonicalMutation) error {
+	return scopemigrate.CaptureCanonical(ctx, tx, mutation)
+}
