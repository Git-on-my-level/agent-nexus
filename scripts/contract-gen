#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

clean_dir() {
  local dir="$1"
  rm -rf "$ROOT_DIR/$dir"
  mkdir -p "$ROOT_DIR/$dir"
}

clean_matching_files() {
  local dir="$1"
  shift
  mkdir -p "$ROOT_DIR/$dir"
  find "$ROOT_DIR/$dir" -maxdepth 1 -type f "$@" -delete
}

clean_dir contracts/gen/go
clean_dir contracts/gen/ts
clean_dir contracts/gen/meta
clean_dir contracts/gen/docs

clean_matching_files cli/internal/registry -name '*.json'
clean_matching_files web-ui/src/lib/generated -name '*.json'
clean_matching_files cli/docs/generated -name '*.md' ! -name 'runtime-help.md'

cd "$ROOT_DIR/core"

go run ./cmd/contract-gen \
  --openapi "../contracts/anx-openapi.yaml" \
  --schema "../contracts/anx-schema.yaml" \
  --out "../contracts/gen" \
  --source-label "contracts/anx-openapi.yaml" \
  --go-module "agent-nexus-contracts-go-client" \
  --ts-package "agent-nexus-contracts-ts-client"

cd "$ROOT_DIR"

# contract-gen writes client.ts only; web-ui imports dist/client.js. Keep dist in sync
# so command_registry_digest matches core's contracts/gen/meta/commands.json.
pnpm exec tsc -p contracts/gen/ts/tsconfig.json

mkdir -p cli/internal/registry
cp contracts/gen/meta/commands.json cli/internal/registry/commands.json
cp contracts/gen/meta/concepts.json cli/internal/registry/concepts.json
cp contracts/gen/meta/help.json cli/internal/registry/help.json
cp contracts/gen/meta/event_ref_rules.json cli/internal/registry/event_ref_rules.json
cp contracts/gen/meta/taxonomy.json cli/internal/registry/taxonomy.json

mkdir -p web-ui/src/lib/generated
cp contracts/gen/meta/event_ref_rules.json web-ui/src/lib/generated/event_ref_rules.json
cp contracts/gen/meta/taxonomy.json web-ui/src/lib/generated/taxonomy.json

mkdir -p cli/docs/generated
cp contracts/gen/docs/commands.md cli/docs/generated/commands.md
cp contracts/gen/docs/command-groups.md cli/docs/generated/command-groups.md
cp contracts/gen/docs/concepts.md cli/docs/generated/concepts.md
cp contracts/gen/docs/x-anx-authoring.md cli/docs/generated/x-anx-authoring.md
cp contracts/gen/docs/x-anx-validation.md cli/docs/generated/x-anx-validation.md
