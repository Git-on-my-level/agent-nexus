#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/hosted/common.sh"

ARTIFACT_DIR="${HOSTED_SMOKE_ARTIFACT_DIR:-$REPO_ROOT/.tmp/hosted-smoke}"
CORE_PORT="${CORE_PORT:-18090}"
CORE_HOST="127.0.0.1"
CORE_BASE_URL="http://${CORE_HOST}:${CORE_PORT}"
SMOKE_TIMEOUT_SECONDS="${HOSTED_SMOKE_TIMEOUT_SECONDS:-60}"

mkdir -p "$ARTIFACT_DIR"
TMP_DIR="$(mktemp -d "$ARTIFACT_DIR/run.XXXXXX")"
CORE_LOG="$TMP_DIR/core.log"
WORKSPACE_ROOT="$TMP_DIR/workspace"
BOOTSTRAP_TOKEN="hosted-smoke-bootstrap-$(generate_token 16)"

cleanup() {
  local code=$?
  stop_background_process "${CORE_PID:-}"

  if [[ $code -ne 0 ]]; then
    echo "hosted smoke failed; artifacts kept at: $TMP_DIR" >&2
    echo "core log: $CORE_LOG" >&2
  else
    echo "hosted smoke artifacts: $TMP_DIR"
  fi
}
trap cleanup EXIT INT TERM

assert_http_status() {
  local expected_status="$1"
  local actual_status="$2"
  local context="$3"
  if [[ "$expected_status" != "$actual_status" ]]; then
    echo "assertion failed: expected HTTP $expected_status, got $actual_status ($context)" >&2
    exit 1
  fi
}

extract_thread_id() {
  local json="$1"
  json_get_first "$json" thread_id topic.thread_id id thread.thread_id thread.id || true
}

extract_inbox_items_json() {
  local json="$1"
  json_get "$json" items 2>/dev/null || printf '%s\n' "$json"
}

require_command curl go python3 sed

echo "Building core and CLI binaries..."
CORE_BIN="$(build_core_binary "$TMP_DIR/anx-core")"
CLI_BIN="$TMP_DIR/anx"
(cd "$REPO_ROOT/cli" && go build -o "$CLI_BIN" ./cmd/anx)
SCHEMA_PATH="$(resolve_schema_path)"
CONFIG_DIR="$TMP_DIR/anx-config"

echo "Starting core in hosted mode (no dev flags)..."
mkdir -p "$WORKSPACE_ROOT"
start_core_server \
  CORE_PID \
  "$CORE_BIN" \
  "$WORKSPACE_ROOT" \
  "$SCHEMA_PATH" \
  "$CORE_HOST" \
  "$CORE_PORT" \
  "$CORE_LOG" \
  "" \
  set \
  "$BOOTSTRAP_TOKEN" \
  false \
  false \
  false

if ! wait_for_http_ok "$CORE_BASE_URL/readyz" "$SMOKE_TIMEOUT_SECONDS"; then
  echo "core did not become healthy" >&2
  cat "$CORE_LOG" >&2 || true
  exit 1
fi

echo ""
echo "=== Test 1: Anonymous workspace read is rejected ==="
ANON_THREADS_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' "$CORE_BASE_URL/threads" || true)
assert_http_status "401" "$ANON_THREADS_STATUS" "anonymous /threads read"

ANON_DOCS_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' "$CORE_BASE_URL/docs" || true)
assert_http_status "401" "$ANON_DOCS_STATUS" "anonymous /docs read"

ANON_BOARDS_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' "$CORE_BASE_URL/boards" || true)
assert_http_status "401" "$ANON_BOARDS_STATUS" "anonymous /boards read"

echo "✓ Anonymous reads correctly rejected"

echo ""
echo "=== Test 2: Legacy actor create/select unavailable outside dev mode ==="
LEGACY_ACTOR_PAYLOAD='{"actor":{"id":"legacy-actor-1","display_name":"Legacy Actor"}}'
LEGACY_ACTOR_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' -H "content-type: application/json" -X POST -d "$LEGACY_ACTOR_PAYLOAD" "$CORE_BASE_URL/actors" || true)
if [[ "$LEGACY_ACTOR_STATUS" != "403" ]] && [[ "$LEGACY_ACTOR_STATUS" != "401" ]] && [[ "$LEGACY_ACTOR_STATUS" != "404" ]]; then
  echo "assertion failed: expected legacy actor creation to fail, got HTTP $LEGACY_ACTOR_STATUS" >&2
  exit 1
fi
echo "✓ Legacy actor flows correctly unavailable"

echo ""
echo "=== Test 3: Human bootstrap and host enrollment ==="
# Synthetic passkey onboarding is enabled only for this temporary bootstrap phase.
# The workspace is restarted in hosted mode for the authorization checks below.
stop_background_process "$CORE_PID"
touch "$WORKSPACE_ROOT/.anx-dev-insecure-auth"
export ANX_ALLOW_PASSKEY_DEV_BYPASS=1
start_core_server CORE_PID "$CORE_BIN" "$WORKSPACE_ROOT" "$SCHEMA_PATH" "$CORE_HOST" "$CORE_PORT" "$CORE_LOG" "" set "$BOOTSTRAP_TOKEN" true false false
wait_for_http_ok "$CORE_BASE_URL/readyz" "$SMOKE_TIMEOUT_SECONDS" || die "bootstrap core failed to start"

BAD_BOOTSTRAP_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' -H 'content-type: application/json' -X POST \
  -d '{"display_name":"Bad bootstrap","bootstrap_token":"wrong-token"}' "$CORE_BASE_URL/auth/passkey/dev/register" || true)
assert_http_status "401" "$BAD_BOOTSTRAP_STATUS" "invalid human bootstrap token"
HUMAN_RESPONSE=$(curl -fsS -H 'content-type: application/json' -X POST \
  -d "{\"display_name\":\"Hosted smoke operator\",\"bootstrap_token\":\"$BOOTSTRAP_TOKEN\"}" "$CORE_BASE_URL/auth/passkey/dev/register")
HUMAN_TOKEN="$(json_get "$HUMAN_RESPONSE" tokens.access_token)"
BOOTSTRAP_REPLAY_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' -H 'content-type: application/json' -X POST \
  -d "{\"display_name\":\"Replay\",\"bootstrap_token\":\"$BOOTSTRAP_TOKEN\"}" "$CORE_BASE_URL/auth/passkey/dev/register" || true)
assert_http_status "401" "$BOOTSTRAP_REPLAY_STATUS" "replayed human bootstrap token"
TOKEN_EXPIRY="$(python3 -c 'import datetime; print((datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(minutes=20)).isoformat())')"
ENROLLMENT_RESPONSE=$(curl -fsS -H 'content-type: application/json' -H "authorization: Bearer $HUMAN_TOKEN" -X POST \
  -d "{\"label\":\"Hosted smoke host\",\"expires_at\":\"$TOKEN_EXPIRY\"}" "$CORE_BASE_URL/auth/hosts/enrollment-tokens")
ENROLLMENT_TOKEN="$(json_get "$ENROLLMENT_RESPONSE" token)"
"$CLI_BIN" --json --base-url "$CORE_BASE_URL" --config-dir "$CONFIG_DIR" host enroll --name hosted-smoke --token "$ENROLLMENT_TOKEN" >"$TMP_DIR/host-enroll.json"
stop_background_process "$CORE_PID"
unset ANX_ALLOW_PASSKEY_DEV_BYPASS
rm -f "$WORKSPACE_ROOT/.anx-dev-insecure-auth"
start_core_server CORE_PID "$CORE_BIN" "$WORKSPACE_ROOT" "$SCHEMA_PATH" "$CORE_HOST" "$CORE_PORT" "$CORE_LOG" "" set "$BOOTSTRAP_TOKEN" false false false
wait_for_http_ok "$CORE_BASE_URL/readyz" "$SMOKE_TIMEOUT_SECONDS" || die "hosted core failed to restart"

echo "=== Test 4: Derived host agents are distinct ==="
TOKEN1_RESPONSE=$("$CLI_BIN" --json --base-url "$CORE_BASE_URL" --config-dir "$CONFIG_DIR" host token --as hosted-agent-1)
TOKEN3_RESPONSE=$("$CLI_BIN" --json --base-url "$CORE_BASE_URL" --config-dir "$CONFIG_DIR" host token --as hosted-agent-3)
AGENT1_TOKEN="$(json_get "$TOKEN1_RESPONSE" result.token)"
AGENT3_TOKEN="$(json_get "$TOKEN3_RESPONSE" result.token)"
[[ -n "$AGENT1_TOKEN" && -n "$AGENT3_TOKEN" && "$AGENT1_TOKEN" != "$AGENT3_TOKEN" ]] || die "derived agent tokens are missing or identical"
AGENT1_RESPONSE=$(curl -fsS -H "authorization: Bearer $AGENT1_TOKEN" "$CORE_BASE_URL/agents/me")
AGENT1_ACTOR_ID="$(json_get "$AGENT1_RESPONSE" agent.actor_id)"
[[ -n "$AGENT1_ACTOR_ID" ]] || die "derived agent actor id missing"
echo "✓ Human-approved host and distinct derived agents work"

echo "=== Test 5: Authenticated workspace read/write works ==="
echo "Creating topic with authenticated agent..."
THREAD_RESPONSE=$(curl -sS \
  -H "content-type: application/json" \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  -X POST \
  -d '{
    "topic":{
      "title":"Hosted smoke thread",
      "summary":"smoke test",
      "cadence":"daily",
      "owner_refs":[],
      "document_refs":[],
      "board_refs":[],
      "related_refs":[],
      "provenance":{"sources":["event:hosted-smoke-thread"]}
    }
  }' \
  "$CORE_BASE_URL/topics")

THREAD_ID="$(extract_thread_id "$THREAD_RESPONSE")"
if [[ -z "$THREAD_ID" ]]; then
  echo "failed to extract thread id" >&2
  echo "response: $THREAD_RESPONSE" >&2
  exit 1
fi

echo "Reading threads with authenticated agent..."
THREADS_READ_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  "$CORE_BASE_URL/threads" || true)
assert_http_status "200" "$THREADS_READ_STATUS" "authenticated /threads read"

echo "Reading specific thread with authenticated agent..."
THREAD_READ_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  "$CORE_BASE_URL/threads/$THREAD_ID" || true)
assert_http_status "200" "$THREAD_READ_STATUS" "authenticated thread read"

echo "Creating event with authenticated agent..."
EVENT_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' \
  -H "content-type: application/json" \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  -X POST \
  -d "{
    \"event\":{
      \"type\":\"message_posted\",
      \"thread_id\":\"$THREAD_ID\",
      \"refs\":[\"thread:$THREAD_ID\"],
      \"summary\":\"hosted smoke event\",
      \"payload\":{\"body\":\"test\"},
      \"provenance\":{\"sources\":[\"event:hosted-smoke-message\"]}
    }
  }" \
  "$CORE_BASE_URL/events" || true)
assert_http_status "201" "$EVENT_STATUS" "authenticated event create"

echo "✓ Authenticated workspace read/write works"

echo ""
echo "=== Test 6: Derived view rebuild is idempotent ==="
echo "Creating second topic backing thread..."
SECOND_THREAD_RESPONSE=$(curl -sS \
  -H "content-type: application/json" \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  -X POST \
  -d '{
    "topic":{
      "title":"Second hosted thread",
      "summary":"second hosted smoke thread",
      "cadence":"daily",
      "owner_refs":[],
      "document_refs":[],
      "board_refs":[],
      "related_refs":[],
      "provenance":{"sources":["inferred"]}
    }
  }' \
  "$CORE_BASE_URL/topics")

SECOND_THREAD_ID="$(extract_thread_id "$SECOND_THREAD_RESPONSE")"
if [[ -z "$SECOND_THREAD_ID" ]]; then
  echo "failed to extract second thread id" >&2
  echo "response: $SECOND_THREAD_RESPONSE" >&2
  exit 1
fi

echo "Rebuilding derived views..."
REBUILD_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' \
  -H "content-type: application/json" \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  -X POST \
  -d "{\"actor_id\":\"$AGENT1_ACTOR_ID\"}" \
  "$CORE_BASE_URL/derived/rebuild" || true)
assert_http_status "200" "$REBUILD_STATUS" "derived rebuild"

THREADS_AFTER_REBUILD=$(curl -sS \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  "$CORE_BASE_URL/threads?state=active&limit=1000")
if ! printf '%s' "$THREADS_AFTER_REBUILD" | python3 -c "
import json, sys
want = set(sys.argv[1:])
data = json.load(sys.stdin)
got = {str(t.get('id', '')) for t in data.get('threads') or []}
sys.exit(0 if want <= got else 1)
" "$THREAD_ID" "$SECOND_THREAD_ID"; then
  echo "expected created topic backing threads in /threads listing" >&2
  echo "response: $THREADS_AFTER_REBUILD" >&2
  exit 1
fi

echo "Rebuilding derived views again to verify idempotence..."
REBUILD_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' \
  -H "content-type: application/json" \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  -X POST \
  -d "{\"actor_id\":\"$AGENT1_ACTOR_ID\"}" \
  "$CORE_BASE_URL/derived/rebuild" || true)
assert_http_status "200" "$REBUILD_STATUS" "second derived rebuild"

THREADS_AFTER_SECOND_REBUILD=$(curl -sS \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  "$CORE_BASE_URL/threads?state=active&limit=1000")
if ! printf '%s' "$THREADS_AFTER_SECOND_REBUILD" | python3 -c "
import json, sys
want = set(sys.argv[1:])
data = json.load(sys.stdin)
got = {str(t.get('id', '')) for t in data.get('threads') or []}
sys.exit(0 if want <= got else 1)
" "$THREAD_ID" "$SECOND_THREAD_ID"; then
  echo "expected created topic backing threads after second rebuild" >&2
  echo "response: $THREADS_AFTER_SECOND_REBUILD" >&2
  exit 1
fi

echo "✓ Derived view rebuild is idempotent"

echo ""
echo "=== Test 7: Ops-health endpoint requires auth and returns diagnostics ==="
echo "Verifying /ops/health rejects anonymous requests..."
ANON_OPS_HEALTH_STATUS=$(curl -sS -o /dev/null -w '%{http_code}' "$CORE_BASE_URL/ops/health" || true)
assert_http_status "401" "$ANON_OPS_HEALTH_STATUS" "anonymous /ops/health"

echo "Verifying /ops/health returns diagnostics for authenticated agent..."
OPS_HEALTH_RESPONSE=$(curl -sS \
  -H "authorization: Bearer $AGENT1_TOKEN" \
  "$CORE_BASE_URL/ops/health")
OPS_HEALTH_OK=$(json_get "$OPS_HEALTH_RESPONSE" ok || true)
if [[ "$OPS_HEALTH_OK" != "true" ]]; then
  echo "expected /ops/health to return ok=true, got: $OPS_HEALTH_RESPONSE" >&2
  exit 1
fi

echo "Verifying /ops/health includes projection_maintenance when available..."
OPS_HEALTH_PROJ=$(json_get "$OPS_HEALTH_RESPONSE" projection_maintenance || true)
if [[ -z "$OPS_HEALTH_PROJ" ]] || [[ "$OPS_HEALTH_PROJ" == "null" ]]; then
  echo "/ops/health projection_maintenance missing or null (may be expected if maintainer disabled)" >&2
fi

echo "✓ Ops-health endpoint works correctly"

echo ""
echo "=== Test 8: Host exclusion blocks derived token grants ==="
"$CLI_BIN" --json --base-url "$CORE_BASE_URL" --config-dir "$CONFIG_DIR" host exclude hosted-agent-3 >"$TMP_DIR/host-exclude.json"
if "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --config-dir "$CONFIG_DIR" host token --as hosted-agent-3 >"$TMP_DIR/excluded-token.json"; then
  die "excluded derived agent received a token"
fi
[[ "$(json_get "$(cat "$TMP_DIR/excluded-token.json")" error.code)" == "agent_excluded" ]] || die "unexpected exclusion error"
echo "✓ Host exclusion blocks derived identity"

echo ""
cat >"$TMP_DIR/summary.txt" <<SUMMARY
core_base_url=${CORE_BASE_URL}
bootstrap_token_used=true
host_enrolled=true
authenticated_agent=hosted-agent-1
second_thread_id=${SECOND_THREAD_ID}
ops_health_tested=true
host_exclusion_tested=true
coverage=auth,host-enrollment,workspace,derived-rebuild,ops-health,exclusion
artifacts_dir=${TMP_DIR}
SUMMARY

echo ""
echo "=== Hosted smoke completed successfully ==="
cat "$TMP_DIR/summary.txt"
