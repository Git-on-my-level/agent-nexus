#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ARTIFACT_DIR="${SMOKE_ARTIFACT_DIR:-$ROOT_DIR/.tmp/e2e-smoke}"
REQUESTED_CORE_PORT="${CORE_PORT:-18080}"
REQUESTED_UI_PORT="${UI_PORT:-4179}"
AUTO_SELECT_PORTS="${AUTO_SELECT_PORTS:-1}"
CORE_HOST="127.0.0.1"
UI_HOST="127.0.0.1"
UI_WORKSPACE_SLUG="${UI_WORKSPACE_SLUG:-${UI_PROJECT_SLUG:-local}}"
BOOTSTRAP_TOKEN="${BOOTSTRAP_TOKEN:-smoke-bootstrap-token}"

mkdir -p "$ARTIFACT_DIR"
TMP_DIR="$(mktemp -d "$ARTIFACT_DIR/run.XXXXXX")"

CORE_LOG="$TMP_DIR/core.log"
UI_LOG="$TMP_DIR/web-ui.log"

HOME_DIR="$TMP_DIR/home"
mkdir -p "$HOME_DIR"
CLI_BIN="$TMP_DIR/anx"
AGENT_NAME="smoke-agent"
USERNAME="smoke-agent.smoke-host"
OWNED_PROCESS_PY="$ROOT_DIR/scripts/owned_process.py"
CORE_RECEIPT="$TMP_DIR/core-process.json"
UI_RECEIPT="$TMP_DIR/web-ui-process.json"
# Integer seconds. The supervisor also enforces this as the child shutdown bound.
SMOKE_SHUTDOWN_DEADLINE="${SMOKE_SHUTDOWN_DEADLINE:-15}"

# Background the supervisor in this shell. Command substitution would reparent it
# and the supervisor would treat that as launcher death.
start_supervised() {
  local receipt="$1"
  local label="$2"
  local log="$3"
  local cwd="$4"
  shift 4
  python3 "$OWNED_PROCESS_PY" supervise \
    --receipt "$receipt" \
    --label "$label" \
    --shutdown-deadline "$SMOKE_SHUTDOWN_DEADLINE" \
    --cwd "$cwd" \
    -- "$@" >"$log" 2>&1 &
  SUPERVISED_PID=$!
}

stop_supervised() {
  local pid="$1"
  local receipt="$2"
  local status=0
  # Receipt proof is the only signal path. A bare pid may have been reused.
  if [[ -f "$receipt" ]]; then
    if ! python3 "$OWNED_PROCESS_PY" stop \
      --receipt "$receipt" \
      --shutdown-deadline "$SMOKE_SHUTDOWN_DEADLINE"; then
      status=1
    fi
  fi
  # Reap a child that has already exited. A live pid was not proved; do not wait on it.
  if [[ -n "${pid:-}" ]] && ! kill -0 "$pid" >/dev/null 2>&1; then
    wait "$pid" >/dev/null 2>&1 || true
  fi
  return "$status"
}

cleanup() {
  local code=$?
  trap - EXIT
  # Stop the UI first so it drops core connections, then the core tree.
  # Each supervisor reaps processes that still carry its exact token.
  # SIGKILL of this script is not catchable: a supervisor that is still alive
  # notices the parent pid change and reaps. SIGKILL of the supervisor itself,
  # or a grandchild that leaves the group and clears OWNED_PROCESS_TOKEN, can
  # still leave a process. This trap does not signal any pid outside those receipts.
  # Both trees are attempted. The caller that invoked stop_supervised directly
  # sees a non-zero status; this trap must not skip the second tree.
  stop_supervised "${UI_SUP_PID:-}" "$UI_RECEIPT" || true
  stop_supervised "${CORE_SUP_PID:-}" "$CORE_RECEIPT" || true

  if [[ $code -ne 0 ]]; then
    echo "smoke failed; artifacts kept at: $TMP_DIR" >&2
    echo "core log: $CORE_LOG" >&2
    echo "web-ui log: $UI_LOG" >&2
  else
    echo "smoke artifacts: $TMP_DIR"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "${SMOKE_LIFECYCLE_SELFTEST:-}" == "interrupt" ]]; then
  start_supervised "$CORE_RECEIPT" "smoke-selftest" "$CORE_LOG" "$ROOT_DIR" \
    python3 -c 'import time; time.sleep(60)'
  CORE_SUP_PID=$SUPERVISED_PID
  printf '%s\n' "$CORE_SUP_PID" > "$TMP_DIR/supervisor.pid"
  for _ in $(seq 1 50); do
    if [[ -f "$CORE_RECEIPT" ]] && grep -q '"state": "running"' "$CORE_RECEIPT"; then
      break
    fi
    sleep 0.05
  done
  printf 'ready\n' > "$TMP_DIR/ready"
  while true; do
    read -r -t 1 _ || true
  done
fi

if [[ "${SMOKE_LIFECYCLE_SELFTEST:-}" == "foreign" ]]; then
  python3 -c 'import time; time.sleep(60)' &
  foreign=$!
  printf '%s\n' "$foreign" > "$TMP_DIR/foreign.pid"
  python3 - "$CORE_RECEIPT" "$foreign" <<'PY'
import json, sys
path, pid = sys.argv[1], int(sys.argv[2])
payload = {
    "schema_version": 1,
    "label": "foreign",
    "token": "ab" * 16,
    "state": "running",
    "supervisor_pid": pid,
    "supervisor_start": "not-this-process",
    "leader_pid": pid,
    "leader_pgid": pid,
    "leader_start": "not-this-process",
    "limits": {"shutdown_deadline_seconds": 1},
}
open(path, "w").write(json.dumps(payload))
PY
  if stop_supervised "$foreign" "$CORE_RECEIPT"; then
    printf 'stop-ok\n' > "$TMP_DIR/stop-status"
  else
    printf 'stop-failed\n' > "$TMP_DIR/stop-status"
  fi
  if kill -0 "$foreign" >/dev/null 2>&1; then
    printf 'foreign-alive\n' > "$TMP_DIR/foreign-state"
  else
    printf 'foreign-dead\n' > "$TMP_DIR/foreign-state"
  fi
  kill -TERM "$foreign" >/dev/null 2>&1 || true
  wait "$foreign" >/dev/null 2>&1 || true
  exit 0
fi

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "required command not found: $cmd" >&2
    exit 1
  }
}

pick_free_port() {
  node -e '
const net = require("net");
const host = process.argv[1];
const server = net.createServer();
server.unref();
server.on("error", (err) => {
  console.error(err.message);
  process.exit(1);
});
server.listen(0, host, () => {
  const address = server.address();
  if (!address || typeof address.port !== "number") {
    console.error("failed to resolve a free port");
    process.exit(1);
  }
  process.stdout.write(String(address.port));
  server.close();
});
' "${1}"
}

resolve_port() {
  local requested_port="$1"
  local service_name="$2"

  if ! lsof -ti :"${requested_port}" >/dev/null 2>&1; then
    printf '%s\n' "${requested_port}"
    return 0
  fi

  if [[ "${AUTO_SELECT_PORTS}" != "1" ]]; then
    echo "port ${requested_port} is already in use; aborting to avoid killing unrelated processes" >&2
    lsof -i :"${requested_port}" >&2 || true
    exit 1
  fi

  local selected_port
  selected_port="$(pick_free_port "${CORE_HOST}")"
  echo "port ${requested_port} is already in use; using ${selected_port} for ${service_name}" >&2
  printf '%s\n' "${selected_port}"
}

wait_for_url() {
  local url="$1"
  local attempts="${2:-120}"
  local sleep_seconds="${3:-0.25}"
  shift 3 || true

  for _ in $(seq 1 "$attempts"); do
    if curl -fsS "$@" "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$sleep_seconds"
  done
  return 1
}

json_get() {
  local file="$1"
  local path="$2"
  node -e '
const fs = require("fs");
const file = process.argv[1];
const path = process.argv[2].split(".");
const input = fs.readFileSync(file, "utf8").trim();
if (!input) process.exit(2);
const json = JSON.parse(input);
if (path[0] === "data") path[0] = "result";
let cur = json;
for (const key of path) {
  if (key === "") continue;
  if (cur === null || cur === undefined) {
    cur = undefined;
    break;
  }
  if (/^\d+$/.test(key)) {
    cur = cur[Number(key)];
  } else {
    cur = cur[key];
  }
}
if (cur === undefined || cur === null) process.exit(3);
if (typeof cur === "object") {
  process.stdout.write(JSON.stringify(cur));
} else {
  process.stdout.write(String(cur));
}
' "$file" "$path"
}

assert_contains() {
  local file="$1"
  local pattern="$2"
  if command -v rg >/dev/null 2>&1; then
    if rg -q "$pattern" "$file"; then
      return 0
    fi
  elif grep -Eq "$pattern" "$file"; then
    return 0
  fi

  echo "assertion failed: expected pattern '$pattern' in $file" >&2
  exit 1
}

run_cli_json() {
  local outfile="$1"
  shift
  HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" "$@" >"$outfile"
}

run_cli_json_payload_retry() {
  local outfile="$1"
  local payload="$2"
  local max_attempts="${3:-2}"
  shift 3

  local attempt error_code status_code
  for attempt in $(seq 1 "$max_attempts"); do
    if printf '%s\n' "$payload" | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" "$@" >"$outfile"; then
      return 0
    fi

    error_code="$(json_get "$outfile" 'error.code' || true)"
    status_code="$(json_get "$outfile" 'error.details.status' || true)"
    if [[ "$attempt" -lt "$max_attempts" && "$error_code" == "internal_error" && "$status_code" == "500" ]]; then
      sleep 0.5
      continue
    fi
    return 1
  done

  return 1
}

board_create_attempt() {
  printf '{"board":{"id":"%s","title":"Smoke Board","owners":["%s"],"primary_topic_ref":"topic:%s","thread_id":"%s","document_refs":["document:%s"],"pinned_refs":["document:%s"],"provenance":{"sources":["event:smoke-board-create"]}}}\n' \
    "$BOARD_ID" "$USERNAME" "$MAIN_TOPIC_ID" "$BOARD_ID" "$PRIMARY_DOC_ID" "$PRIMARY_DOC_ID" \
    | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" boards create >"$TMP_DIR/board-create.json"
}

ensure_board_created() {
  local max_attempts="${1:-2}"
  local attempt error_code status_code

  for attempt in $(seq 1 "$max_attempts"); do
    if board_create_attempt; then
      return 0
    fi

    # GitHub-hosted runners occasionally surface a transient 500 here even
    # though the preceding authenticated board setup succeeded locally and in
    # repeated stress runs. Probe for the board first, then retry once before
    # failing the full smoke flow.
    if run_cli_json "$TMP_DIR/board-get.json" boards get "$BOARD_ID"; then
      return 0
    fi

    error_code="$(json_get "$TMP_DIR/board-create.json" 'error.code' || true)"
    status_code="$(json_get "$TMP_DIR/board-create.json" 'error.details.status' || true)"
    if [[ "$attempt" -lt "$max_attempts" && "$error_code" == "internal_error" && "$status_code" == "500" ]]; then
      sleep 0.5
      continue
    fi
    return 1
  done

  return 1
}

require_cmd curl
require_cmd go
require_cmd node
require_cmd pnpm
require_cmd python3

CORE_PORT="$(resolve_port "${REQUESTED_CORE_PORT}" "anx-core")"
UI_PORT="$(resolve_port "${REQUESTED_UI_PORT}" "web-ui")"
CORE_BASE_URL="http://${CORE_HOST}:${CORE_PORT}"
UI_BASE_URL="http://${UI_HOST}:${UI_PORT}"
UI_ORG_SLUG="${ANX_DEFAULT_ORGANIZATION:-local}"

# Build CLI binary once for deterministic smoke steps.
(
  cd "$ROOT_DIR/cli"
  go build -o "$CLI_BIN" ./cmd/anx )

# Exercise host enrollment flag parsing with a token that begins with a hyphen.
# --plan keeps this regression check local and avoids sending the token anywhere.
HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" host enroll \
  --name smoke-token-parser --token=-smoke-leading-hyphen --plan \
  >"$TMP_DIR/token-flag-regression.json"

EXPECTED_VERSION="$("${ROOT_DIR}/scripts/read-version.sh")"
MIN_CLI_VERSION="$(sed -n 's/^const MinCompatibleCLI = "\([^"]*\)"$/\1/p' "${ROOT_DIR}/core/internal/buildinfo/compatibility.go")"
if [[ -z "${MIN_CLI_VERSION}" ]]; then
  echo "could not read MinCompatibleCLI" >&2
  exit 1
fi

# Start core under a supervisor whose session owns go run and the server it execs.
mkdir -p "$TMP_DIR/workspace"
touch "$TMP_DIR/workspace/.anx-dev-insecure-auth"
start_supervised "$CORE_RECEIPT" "anx-e2e-core" "$CORE_LOG" "$ROOT_DIR/core" \
  env \
    ANX_BOOTSTRAP_TOKEN="$BOOTSTRAP_TOKEN" \
    ANX_ALLOW_PASSKEY_DEV_BYPASS=1 \
    ANX_HOSTED_DEV_MODE=1 \
    ANX_ENABLE_DEV_ACTOR_MODE=1 \
    go run ./cmd/anx-core \
    --listen-addr "${CORE_HOST}:${CORE_PORT}" \
    --workspace-root "$TMP_DIR/workspace" \
    --schema-path "$ROOT_DIR/contracts/anx-schema.yaml"
CORE_SUP_PID=$SUPERVISED_PID

if ! wait_for_url "$CORE_BASE_URL/readyz" 320 0.15; then
  echo "core did not become healthy" >&2
  cat "$CORE_LOG" >&2 || true
  exit 1
fi

# Start web-ui under its own supervisor so pnpm, vite, and esbuild die with it.
start_supervised "$UI_RECEIPT" "anx-e2e-web-ui" "$UI_LOG" "$ROOT_DIR" \
  env \
    ANX_WORKSPACES="[{\"organizationSlug\":\"local\",\"slug\":\"${UI_WORKSPACE_SLUG}\",\"label\":\"${UI_WORKSPACE_SLUG}\",\"coreBaseUrl\":\"${CORE_BASE_URL}\"}]" \
    ANX_DEFAULT_ORGANIZATION="${ANX_DEFAULT_ORGANIZATION:-local}" \
    ANX_DEFAULT_WORKSPACE="$UI_WORKSPACE_SLUG" \
    pnpm -C web-ui exec vite dev --host "$UI_HOST" --port "$UI_PORT"
UI_SUP_PID=$SUPERVISED_PID

if ! wait_for_url "$UI_BASE_URL/meta/handshake" 180 0.2 \
  -H "x-anx-organization-slug: ${UI_ORG_SLUG}" \
  -H "x-anx-workspace-slug: ${UI_WORKSPACE_SLUG}"; then
  echo "web-ui did not become ready on /meta/handshake" >&2
  cat "$UI_LOG" >&2 || true
  exit 1
fi

# Verify UI serves shell too.
curl -fsS -D "$TMP_DIR/ui-shell-headers.txt" -o /dev/null "$UI_BASE_URL/"

# Handshake/version checks.
curl -fsS "$CORE_BASE_URL/meta/handshake" >"$TMP_DIR/core-handshake.json"
curl -fsS "$CORE_BASE_URL/version" >"$TMP_DIR/core-version.json"
assert_contains "$TMP_DIR/core-handshake.json" '"schema_version"'
assert_contains "$TMP_DIR/core-version.json" '"schema_version"'
if [[ "$(json_get "$TMP_DIR/core-handshake.json" 'core_version')" != "$EXPECTED_VERSION" ]]; then
  echo "core_version mismatch in handshake" >&2
  cat "$TMP_DIR/core-handshake.json" >&2 || true
  exit 1
fi
if [[ "$(json_get "$TMP_DIR/core-handshake.json" 'min_cli_version')" != "$MIN_CLI_VERSION" ]]; then
  echo "min_cli_version mismatch in handshake" >&2
  cat "$TMP_DIR/core-handshake.json" >&2 || true
  exit 1
fi
if [[ "$(json_get "$TMP_DIR/core-handshake.json" 'recommended_cli_version')" != "$EXPECTED_VERSION" ]]; then
  echo "recommended_cli_version mismatch in handshake" >&2
  cat "$TMP_DIR/core-handshake.json" >&2 || true
  exit 1
fi

UI_VERSION_HEADER="$(
  awk -F': *' '
    BEGIN { IGNORECASE = 1 }
    tolower($1) == "x-anx-ui-version" {
      value = $2
      sub(/\r$/, "", value)
      print value
      exit
    }
  ' "$TMP_DIR/ui-shell-headers.txt"
)"
if [[ "$UI_VERSION_HEADER" != "$EXPECTED_VERSION" ]]; then
  echo "ui version header mismatch" >&2
  cat "$TMP_DIR/ui-shell-headers.txt" >&2 || true
  exit 1
fi

# Enroll a host through a one-time token issued by the bootstrap human.
curl -fsS -H 'Content-Type: application/json' -d "{\"display_name\":\"Smoke operator\",\"bootstrap_token\":\"$BOOTSTRAP_TOKEN\"}" "$CORE_BASE_URL/auth/passkey/dev/register" >"$TMP_DIR/human.json"
HUMAN_TOKEN="$(json_get "$TMP_DIR/human.json" 'tokens.access_token')"
TOKEN_EXPIRY="$(node -e 'process.stdout.write(new Date(Date.now()+20*60*1000).toISOString())')"
curl -fsS -H 'Content-Type: application/json' -H "Authorization: Bearer $HUMAN_TOKEN" -d "{\"label\":\"Smoke host\",\"expires_at\":\"$TOKEN_EXPIRY\"}" "$CORE_BASE_URL/auth/hosts/enrollment-tokens" >"$TMP_DIR/enrollment-token.json"
ENROLLMENT_TOKEN="$(json_get "$TMP_DIR/enrollment-token.json" 'token')"
run_cli_json "$TMP_DIR/enroll.json" host enroll --name smoke-host --token="$ENROLLMENT_TOKEN"
run_cli_json "$TMP_DIR/whoami.json" auth whoami
run_cli_json "$TMP_DIR/host-token.json" host token --as "$AGENT_NAME"
run_cli_json "$TMP_DIR/topics-list-before.json" topics list

# Typed command flow: topic -> board -> cards -> packets.
MAIN_TOPIC_PAYLOAD='{"topic":{"id":"topic-smoke-main","title":"Smoke coordination topic","summary":"Smoke workflow in progress","owner_refs":[],"board_refs":[],"document_refs":[],"related_refs":["topic:topic-smoke-main"],"provenance":{"sources":["event:smoke-topic-main"]}}}'
run_cli_json_payload_retry "$TMP_DIR/topic-create.json" "$MAIN_TOPIC_PAYLOAD" 3 topics create
MAIN_TOPIC_ID="$(json_get "$TMP_DIR/topic-create.json" 'data.topic.id' || true)"
if [[ -z "$MAIN_TOPIC_ID" ]]; then
  MAIN_TOPIC_ID="$(json_get "$TMP_DIR/topic-create.json" 'data.body.topic.id' || true)"
fi
MAIN_TOPIC_THREAD_ID="$(json_get "$TMP_DIR/topic-create.json" 'data.topic.thread_id' || true)"
if [[ -z "$MAIN_TOPIC_THREAD_ID" ]]; then
  MAIN_TOPIC_THREAD_ID="$(json_get "$TMP_DIR/topic-create.json" 'data.body.topic.thread_id' || true)"
fi
if [[ -z "$MAIN_TOPIC_ID" || -z "$MAIN_TOPIC_THREAD_ID" ]]; then
  echo "failed to parse main topic id or backing thread id" >&2
  cat "$TMP_DIR/topic-create.json" >&2 || true
  exit 1
fi

printf '{"patch":{"summary":"smoke updated"}}\n' \
  | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" topics patch "$MAIN_TOPIC_ID" >"$TMP_DIR/topic-update.json"

THREAD_ID="$MAIN_TOPIC_THREAD_ID"

# Board smoke: create a board, add/reorder/move/archive cards, and verify the
# canonical workspace through both core and the UI proxy.
BOARD_TOPIC_A_PAYLOAD='{"topic":{"id":"topic-smoke-board-a","title":"Smoke board card A","summary":"board card A","owner_refs":[],"board_refs":[],"document_refs":[],"related_refs":["topic:topic-smoke-board-a"],"provenance":{"sources":["event:smoke-topic-board-a"]}}}'
run_cli_json_payload_retry "$TMP_DIR/board-topic-a-create.json" "$BOARD_TOPIC_A_PAYLOAD" 3 topics create
BOARD_TOPIC_A_ID="$(json_get "$TMP_DIR/board-topic-a-create.json" 'data.topic.id' || true)"
if [[ -z "$BOARD_TOPIC_A_ID" ]]; then
  BOARD_TOPIC_A_ID="$(json_get "$TMP_DIR/board-topic-a-create.json" 'data.body.topic.id' || true)"
fi
BOARD_THREAD_A_ID="$(json_get "$TMP_DIR/board-topic-a-create.json" 'data.topic.thread_id' || true)"
if [[ -z "$BOARD_THREAD_A_ID" ]]; then
  BOARD_THREAD_A_ID="$(json_get "$TMP_DIR/board-topic-a-create.json" 'data.body.topic.thread_id' || true)"
fi
if [[ -z "$BOARD_THREAD_A_ID" ]]; then
  echo "failed to parse board topic A id or backing thread id" >&2
  cat "$TMP_DIR/board-topic-a-create.json" >&2 || true
  exit 1
fi
if [[ -z "$BOARD_TOPIC_A_ID" ]]; then
  echo "failed to parse board topic A id" >&2
  cat "$TMP_DIR/board-topic-a-create.json" >&2 || true
  exit 1
fi

BOARD_TOPIC_B_PAYLOAD='{"topic":{"id":"topic-smoke-board-b","title":"Smoke board card B","summary":"board card B","owner_refs":[],"board_refs":[],"document_refs":[],"related_refs":["topic:topic-smoke-board-b"],"provenance":{"sources":["event:smoke-topic-board-b"]}}}'
run_cli_json_payload_retry "$TMP_DIR/board-topic-b-create.json" "$BOARD_TOPIC_B_PAYLOAD" 3 topics create
BOARD_TOPIC_B_ID="$(json_get "$TMP_DIR/board-topic-b-create.json" 'data.topic.id' || true)"
if [[ -z "$BOARD_TOPIC_B_ID" ]]; then
  BOARD_TOPIC_B_ID="$(json_get "$TMP_DIR/board-topic-b-create.json" 'data.body.topic.id' || true)"
fi
BOARD_THREAD_B_ID="$(json_get "$TMP_DIR/board-topic-b-create.json" 'data.topic.thread_id' || true)"
if [[ -z "$BOARD_THREAD_B_ID" ]]; then
  BOARD_THREAD_B_ID="$(json_get "$TMP_DIR/board-topic-b-create.json" 'data.body.topic.thread_id' || true)"
fi
if [[ -z "$BOARD_THREAD_B_ID" ]]; then
  echo "failed to parse board topic B id or backing thread id" >&2
  cat "$TMP_DIR/board-topic-b-create.json" >&2 || true
  exit 1
fi

PRIMARY_DOC_ID="doc-smoke-board-primary"
CARD_DOC_ID="doc-smoke-board-card"

PRIMARY_DOC_PAYLOAD="$(printf '{"document":{"id":"%s","title":"Smoke Board Primary Doc"},"refs":["topic:%s","thread:%s"],"content":"Primary board document","content_type":"text"}' "$PRIMARY_DOC_ID" "$MAIN_TOPIC_ID" "$THREAD_ID")"
run_cli_json_payload_retry "$TMP_DIR/board-primary-doc-create.json" "$PRIMARY_DOC_PAYLOAD" 3 docs create

CARD_DOC_PAYLOAD="$(printf '{"document":{"id":"%s","title":"Smoke Board Card Doc"},"refs":["topic:%s","thread:%s"],"content":"Pinned card document","content_type":"text"}' "$CARD_DOC_ID" "$BOARD_TOPIC_A_ID" "$BOARD_THREAD_A_ID")"
run_cli_json_payload_retry "$TMP_DIR/board-card-doc-create.json" "$CARD_DOC_PAYLOAD" 3 docs create

BOARD_ID="board-smoke"
if ! ensure_board_created 2; then
  echo "failed to create board after retry" >&2
  cat "$TMP_DIR/board-create.json" >&2 || true
  exit 1
fi

BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-create.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-create.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  run_cli_json "$TMP_DIR/board-get.json" boards get "$BOARD_ID"
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-get.json" 'data.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-get.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  echo "failed to parse board updated_at after create" >&2
  cat "$TMP_DIR/board-create.json" >&2 || true
  cat "$TMP_DIR/board-get.json" >&2 || true
  exit 1
fi

run_cli_json "$TMP_DIR/board-get.json" boards get "$BOARD_ID"

printf '{"board_id":"%s","card":{"title":"Smoke board card A","summary":"smoke card A","column_key":"backlog","topic_ref":"topic:%s","document_ref":"document:%s","assignee_refs":[],"risk":"low","resolution_refs":[],"related_refs":["topic:%s"],"provenance":{"sources":["event:smoke-card-a"]}}}\n' \
  "$BOARD_ID" "$BOARD_TOPIC_A_ID" "$CARD_DOC_ID" "$BOARD_TOPIC_A_ID" \
  | run_cli_json "$TMP_DIR/board-card-a-add.json" cards create
BOARD_CARD_A_ID="$(json_get "$TMP_DIR/board-card-a-add.json" 'data.card.id' || true)"
if [[ -z "$BOARD_CARD_A_ID" ]]; then
  BOARD_CARD_A_ID="$(json_get "$TMP_DIR/board-card-a-add.json" 'data.body.card.id' || true)"
fi
if [[ -z "$BOARD_CARD_A_ID" ]]; then
  echo "failed to parse board card A id" >&2
  cat "$TMP_DIR/board-card-a-add.json" >&2 || true
  exit 1
fi
BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-a-add.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-a-add.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  run_cli_json "$TMP_DIR/board-refresh-after-card-a.json" boards get "$BOARD_ID"
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-refresh-after-card-a.json" 'data.board.updated_at' || true)"
  if [[ -z "$BOARD_UPDATED_AT" ]]; then
    BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-refresh-after-card-a.json" 'data.body.board.updated_at' || true)"
  fi
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  echo "failed to parse board updated_at after card A create" >&2
  exit 1
fi

# Legacy `anx receipts` / `anx reviews` commands were removed; packet convenience
# flows are not exposed as standalone CLI commands in the current registry.

printf '{"board_id":"%s","card":{"title":"Smoke board card B","summary":"smoke card B","column_key":"backlog","after_card_id":"%s","topic_ref":"topic:%s","assignee_refs":[],"risk":"low","resolution_refs":[],"related_refs":["topic:%s"],"provenance":{"sources":["event:smoke-card-b"]}}}\n' \
  "$BOARD_ID" "$BOARD_CARD_A_ID" "$BOARD_TOPIC_B_ID" "$BOARD_TOPIC_B_ID" \
  | run_cli_json "$TMP_DIR/board-card-b-add.json" cards create
BOARD_CARD_B_ID="$(json_get "$TMP_DIR/board-card-b-add.json" 'data.card.id' || true)"
if [[ -z "$BOARD_CARD_B_ID" ]]; then
  BOARD_CARD_B_ID="$(json_get "$TMP_DIR/board-card-b-add.json" 'data.body.card.id' || true)"
fi
if [[ -z "$BOARD_CARD_B_ID" ]]; then
  echo "failed to parse board card B id" >&2
  cat "$TMP_DIR/board-card-b-add.json" >&2 || true
  exit 1
fi
BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-b-add.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-b-add.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  run_cli_json "$TMP_DIR/board-refresh-after-card-b.json" boards get "$BOARD_ID"
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-refresh-after-card-b.json" 'data.board.updated_at' || true)"
  if [[ -z "$BOARD_UPDATED_AT" ]]; then
    BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-refresh-after-card-b.json" 'data.body.board.updated_at' || true)"
  fi
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  echo "failed to parse board updated_at after card B create" >&2
  exit 1
fi

HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" cards move \
  "$BOARD_CARD_B_ID" --column review --if-board-updated-at "$BOARD_UPDATED_AT" >"$TMP_DIR/board-card-b-move.json"
BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-b-move.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-card-b-move.json" 'data.body.board.updated_at' || true)"
fi

ACCESS_TOKEN="$(json_get "$TMP_DIR/host-token.json" 'result.token')"
if [[ -z "$ACCESS_TOKEN" ]]; then
  echo "missing derived-agent token" >&2
  exit 1
fi

run_cli_json "$TMP_DIR/board-workspace.json" boards workspace "$BOARD_ID"
assert_contains "$TMP_DIR/board-workspace.json" "\"board_id\"[[:space:]]*:[[:space:]]*\"$BOARD_ID\""
# Card B is anchored on topic B; backing thread ids are per-card (not the topic's thread_id).
assert_contains "$TMP_DIR/board-workspace.json" '"topic:topic-smoke-board-b"'
assert_contains "$TMP_DIR/board-workspace.json" "\"column_key\"[[:space:]]*:[[:space:]]*\"review\""

curl -fsS -H "x-anx-organization-slug: ${UI_ORG_SLUG}" -H "x-anx-workspace-slug: ${UI_WORKSPACE_SLUG}" -H "Authorization: Bearer $ACCESS_TOKEN" "$UI_BASE_URL/boards/${BOARD_ID}/workspace" >"$TMP_DIR/ui-board-workspace.json"
assert_contains "$TMP_DIR/ui-board-workspace.json" "\"board_id\"[[:space:]]*:[[:space:]]*\"$BOARD_ID\""

# Refresh board concurrency token (cards.move may not echo `board` in the CLI envelope).
run_cli_json "$TMP_DIR/board-before-terminal.json" boards get "$BOARD_ID"
BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-before-terminal.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-before-terminal.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  echo "failed to parse board updated_at before terminal card move" >&2
  cat "$TMP_DIR/board-before-terminal.json" >&2 || true
  exit 1
fi

run_cli_json "$TMP_DIR/card-a-backing-thread.json" cards get "$BOARD_CARD_A_ID"
CARD_A_THREAD_ID="$(json_get "$TMP_DIR/card-a-backing-thread.json" 'data.card.thread_id' || true)"
if [[ -z "$CARD_A_THREAD_ID" ]]; then
  CARD_A_THREAD_ID="$(json_get "$TMP_DIR/card-a-backing-thread.json" 'data.body.card.thread_id' || true)"
fi
if [[ -z "$CARD_A_THREAD_ID" ]]; then
  echo "failed to parse backing thread id for card A" >&2
  cat "$TMP_DIR/card-a-backing-thread.json" >&2 || true
  exit 1
fi

printf '{"event":{"type":"message_posted","thread_id":"%s","summary":"smoke terminal resolution evidence","refs":["thread:%s","card:%s"],"payload":{"body":"work completed"},"provenance":{"sources":["event:smoke-terminal-resolution"]}}}\n' \
  "$CARD_A_THREAD_ID" "$CARD_A_THREAD_ID" "$BOARD_CARD_A_ID" \
  | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" debug events create >"$TMP_DIR/terminal-resolution-event.json"
TERMINAL_RESOLUTION_EVENT_ID="$(json_get "$TMP_DIR/terminal-resolution-event.json" 'data.event.id' || true)"
if [[ -z "$TERMINAL_RESOLUTION_EVENT_ID" ]]; then
  TERMINAL_RESOLUTION_EVENT_ID="$(json_get "$TMP_DIR/terminal-resolution-event.json" 'data.body.event.id' || true)"
fi
if [[ -z "$TERMINAL_RESOLUTION_EVENT_ID" ]]; then
  echo "failed to parse event id for terminal resolution evidence" >&2
  cat "$TMP_DIR/terminal-resolution-event.json" >&2 || true
  exit 1
fi

# Spec §8.4: done lane uses resolution done + evidence refs; abandonment uses trash/archive, not resolution=canceled.
printf '{"column_key":"done","resolution":"done","resolution_refs":["event:%s"],"if_board_updated_at":"%s"}\n' "$TERMINAL_RESOLUTION_EVENT_ID" "$BOARD_UPDATED_AT" \
  >"$TMP_DIR/card-a-terminal-done-move.json"
HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" cards move \
  "$BOARD_CARD_A_ID" --from-file "$TMP_DIR/card-a-terminal-done-move.json" >"$TMP_DIR/board-card-a-terminal-done.json"

run_cli_json "$TMP_DIR/board-after-terminal.json" boards get "$BOARD_ID"
BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-after-terminal.json" 'data.board.updated_at' || true)"
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  BOARD_UPDATED_AT="$(json_get "$TMP_DIR/board-after-terminal.json" 'data.body.board.updated_at' || true)"
fi
if [[ -z "$BOARD_UPDATED_AT" ]]; then
  echo "failed to parse board updated_at after terminal done resolution move" >&2
  cat "$TMP_DIR/board-after-terminal.json" >&2 || true
  exit 1
fi

run_cli_json "$TMP_DIR/card-a-after-terminal-done.json" cards get "$BOARD_CARD_A_ID"
assert_contains "$TMP_DIR/card-a-after-terminal-done.json" '"resolution"[[:space:]]*:[[:space:]]*"done"'
node -e 'const fs=require("fs"); const data=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); const card=data?.result?.card ?? data?.result?.body?.card; const refs=Array.isArray(card?.resolution_refs) ? card.resolution_refs : []; const expected=`event:${process.argv[2]}`; if (!refs.includes(expected)) process.exit(1);' "$TMP_DIR/card-a-after-terminal-done.json" "$TERMINAL_RESOLUTION_EVENT_ID" || {
  echo "missing expected resolution ref event:${TERMINAL_RESOLUTION_EVENT_ID}" >&2
  cat "$TMP_DIR/card-a-after-terminal-done.json" >&2 || true
  exit 1
}

# Trash lane (operational lifecycle) — topics support trash; default topic list hides trashed rows.
TRASH_TOPIC_PAYLOAD='{"topic":{"id":"topic-smoke-trash","title":"Smoke trashed topic","summary":"Disposed after smoke","owner_refs":[],"board_refs":[],"document_refs":[],"related_refs":["topic:topic-smoke-trash"],"provenance":{"sources":["event:smoke-topic-trash"]}}}'
run_cli_json_payload_retry "$TMP_DIR/trash-topic-create.json" "$TRASH_TOPIC_PAYLOAD" 3 topics create
HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" topics trash topic-smoke-trash \
  --reason "e2e-smoke trash lane assertion" >"$TMP_DIR/topic-trash.json"
curl -fsS -H "Authorization: Bearer $ACCESS_TOKEN" "${CORE_BASE_URL}/topics?state=trashed" >"$TMP_DIR/topics-trashed-only.json"
assert_contains "$TMP_DIR/topics-trashed-only.json" 'topic-smoke-trash'

# Card trash lane (archive / archived_only inventory).
printf '{"if_board_updated_at":"%s"}\n' "$BOARD_UPDATED_AT" \
  | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" cards archive "$BOARD_CARD_B_ID" --from-file=- >"$TMP_DIR/board-card-b-archive.json"
curl -fsS -H "Authorization: Bearer $ACCESS_TOKEN" "${CORE_BASE_URL}/cards?state=archived" >"$TMP_DIR/cards-archived-only.json"
assert_contains "$TMP_DIR/cards-archived-only.json" "\"${BOARD_CARD_B_ID}\""

printf '{"event":{"type":"message_posted","thread_id":"%s","summary":"smoke stream event","refs":["thread:%s"],"payload":{"body":"hello"},"provenance":{"sources":["event:smoke-stream-event"]}}}\n' "$THREAD_ID" "$THREAD_ID" \
  | HOME="$HOME_DIR" "$CLI_BIN" --json --base-url "$CORE_BASE_URL" --as "$AGENT_NAME" debug events create >"$TMP_DIR/event-create.json"

# Basic UI compatibility check after typed flow.
curl -fsS -H "x-anx-organization-slug: ${UI_ORG_SLUG}" -H "x-anx-workspace-slug: ${UI_WORKSPACE_SLUG}" "$UI_BASE_URL/meta/handshake" >"$TMP_DIR/ui-handshake.json"
assert_contains "$TMP_DIR/ui-handshake.json" '"schema_version"'

cat >"$TMP_DIR/summary.txt" <<SUMMARY
core_base_url=${CORE_BASE_URL}
ui_base_url=${UI_BASE_URL}
thread_id=${THREAD_ID}
board_id=${BOARD_ID}
agent=${AGENT_NAME}
host_config_dir=${HOME_DIR}/.config/anx
artifacts_dir=${TMP_DIR}
SUMMARY

echo "e2e smoke completed successfully"
cat "$TMP_DIR/summary.txt"
